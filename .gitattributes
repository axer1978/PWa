# Normalise line endings in the repo. Scripts and infra files run inside Linux
# containers, so they must stay LF even when checked out on Windows.
* text=auto eol=lf
*.sh text eol=lf
Caddyfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf

*.opus binary
*.m4a binary
*.mmdb binary
*.png binary
*.ico binary
*.woff2 binary
