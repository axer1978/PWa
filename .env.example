# Copy to .env and fill in. Never commit .env.
# Values here suit `docker compose up` locally. "PROD:" notes say what to change on the VPS.
#
# Running the app on your host with `npm run dev` instead? Put host-side overrides
# in .env.development.local (also never committed), e.g.:
#   POSTGRES_HOST=localhost
#   SMTP_URL=smtp://localhost:1025

# --- Compose -------------------------------------------------------------------
# dev = Mailpit + mock providers. PROD: COMPOSE_PROFILES=prod
COMPOSE_PROFILES=dev

# --- App -----------------------------------------------------------------------
# Required, no default. One of: development | test | staging | production
APP_ENV=development
# Public origin the browser sees. PROD: https://your-domain.example
ORIGIN=https://localhost
# Optional: path to the plans/prices file (default config/plans.json)
# PLANS_CONFIG=config/plans.json

# --- Postgres ------------------------------------------------------------------
POSTGRES_USER=app
# PROD: long random value, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional: a full URL overrides the parts above.
# DATABASE_URL=postgres://app:secret@postgres:5432/app

# --- Sign-in email (magic links) ----------------------------------------------
# PROD: your provider, e.g. smtps://user:pass@smtp.provider.example:465
SMTP_URL=smtp://mailpit:1025
# Shows in the listener's inbox: keep it neutral. PROD: a real address on your domain.
EMAIL_FROM=Sign-in <no-reply@localhost>
# smtp | outbox (outbox writes JSON files to OUTBOX_DIR; development/test only)
EMAIL_TRANSPORT=smtp
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=30

# --- Providers -----------------------------------------------------------------
# mock is refused at boot unless APP_ENV is development/test (or staging + ALLOW_MOCKS=true).
AV_PROVIDER=mock
PAYMENT_PROVIDER=mock
STORAGE_DRIVER=local
# Staging only. Refused in production.
ALLOW_MOCKS=false

# --- Geo-blocking --------------------------------------------------------------
# Comma-separated ISO 3166-1 alpha-2 codes. Which countries to block is a legal
# decision for the operator. PROD: must be set explicitly (an empty value = none).
BLOCKED_COUNTRIES=
# When no country can be determined: allow | block. PROD: must be set explicitly.
GEO_UNKNOWN_POLICY=allow
# Country header from a CDN/proxy you control in front of Caddy. Caddy strips any
# client-supplied copy (see infra/Caddyfile).
GEO_COUNTRY_HEADER=X-Country-Code
# Fallback lookup by IP. Fetch with `npm run geoip:fetch` (DB-IP Lite, CC BY 4.0).
# GEOIP_DB_PATH=data/geoip/dbip-country-lite.mmdb

# --- Caddy ---------------------------------------------------------------------
# PROD: your domain (Caddy then gets Let's Encrypt certificates automatically)
DOMAIN=localhost
# PROD: 31536000 (the app refuses to boot in production with less than 15552000)
HSTS_MAX_AGE=0
