{
	"$schema": "./session.schema.json",
	"id": "demo-sub",
	"version": 1,
	"title": "Demo session 2",
	"summary": "Placeholder session with test tones. Requires a subscription.",
	"access": "paid",
	"start": "intro",
	"state": {},
	"nodes": [
		{ "id": "intro", "type": "play", "clipId": "demo-sub-intro", "next": "pick" },
		{
			"id": "pick",
			"type": "choice",
			"clipId": "demo-sub-pick",
			"options": [
				{ "label": "Path A", "target": "a" },
				{ "label": "Path B", "target": "b" }
			]
		},
		{ "id": "a", "type": "play", "clipId": "demo-sub-a", "next": "end-a" },
		{
			"id": "b",
			"type": "timer",
			"clipId": "demo-sub-b",
			"timeoutMs": 6000,
			"defaultTarget": "end-b",
			"next": "b-tapped"
		},
		{ "id": "b-tapped", "type": "play", "clipId": "demo-sub-b-tapped", "next": "end-b" },
		{ "id": "end-a", "type": "end", "clipId": "demo-sub-end-a" },
		{ "id": "end-b", "type": "end", "clipId": "demo-sub-end-b" }
	]
}
